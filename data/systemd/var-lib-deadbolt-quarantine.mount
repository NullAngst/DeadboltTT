[Unit]
Description=Deadbolt quarantine folder, mounted noexec,nosuid,nodev
Documentation=https://github.com/NullAngst/DeadboltTT
DefaultDependencies=no
After=local-fs-pre.target
Before=local-fs.target deadbolt-worker.service
RequiresMountsFor=/var/lib/deadbolt

[Mount]
What=/var/lib/deadbolt/quarantine
Where=/var/lib/deadbolt/quarantine
Type=none
Options=bind,noexec,nosuid,nodev

[Install]
WantedBy=local-fs.target
